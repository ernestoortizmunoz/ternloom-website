{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ternloom-website",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "ternloom.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
