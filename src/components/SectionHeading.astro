---
interface Props { id: string; eyebrow?: string }
const { id, eyebrow } = Astro.props;
---
<div class="section-heading">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id}><slot /></h2>
</div>
<style>
  .section-heading { max-width: var(--reading-width); }
  .section-heading .eyebrow { margin-block-end: var(--space-2); }
</style>
