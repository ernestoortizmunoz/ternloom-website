---
import Brand from './Brand.astro';
import { services } from '../data/services';
import { site } from '../config/site';
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-intro">
      <a class="home-link" href="/" aria-label="Ternloom Technologies — home"><Brand /></a>
      <p>Websites, software and connected tools for small businesses in Ottawa and across Canada.</p>
    </div>
    <nav aria-label="Services"><h2>What we do</h2><ul>{services.map((service) => <li><a href={service.path}>{service.name}</a></li>)}</ul></nav>
    <nav aria-label="Explore"><h2>Explore</h2><ul><li><a href="/projects/">Selected projects</a></li><li><a href="/about/">About Ternloom</a></li><li><a href="/contact/">Contact</a></li></ul></nav>
  </div>
  <div class="container footer-bottom"><p>© {new Date().getFullYear()} {site.name}</p><p>Ottawa, Ontario · Serving Canada</p></div>
</footer>
<style>
  .site-footer { border-block-start: var(--border-width) solid var(--color-line); padding-block: var(--space-8) var(--space-3); }
  .footer-grid { display: grid; grid-template-columns: 1.2fr 1fr 0.6fr; gap: var(--space-6); padding-block-end: var(--space-8); }
  .home-link { display: inline-flex; text-decoration: none; }
  .footer-intro p { max-width: 30ch; margin-block-start: var(--space-3); color: var(--color-muted); font-size: var(--text-support); line-height: var(--leading-body); }
  nav h2 { margin-block-end: var(--space-2); font-size: var(--text-support); font-weight: var(--weight-semibold); letter-spacing: normal; line-height: var(--leading-support); }
  nav ul { list-style: none; padding: 0; }
  nav a { display: inline-flex; align-items: center; min-height: var(--control-height); font-size: var(--text-support); line-height: var(--leading-support); text-decoration: none; }
  nav a:hover { text-decoration: underline; }
  .footer-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-1) var(--space-3); padding-block-start: var(--space-3); border-block-start: var(--border-width) solid var(--color-line); color: var(--color-muted); font-size: var(--text-label); line-height: var(--leading-support); }
  @media (max-width: 48rem) { .footer-grid { grid-template-columns: 1fr 1fr; } .footer-intro { grid-column: 1 / -1; } }
  @media (max-width: 30rem) { .footer-grid { grid-template-columns: 1fr; gap: var(--space-4); } }
</style>
