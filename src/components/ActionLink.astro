---
interface Props { href: string; variant?: 'primary' | 'text' }
const { href, variant = 'primary' } = Astro.props;
---
<a href={href} class:list={['action-link', `action-link--${variant}`]}><span><slot /></span><svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M3 10h13m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg></a>
<style>
  .action-link { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2); min-height: var(--control-height); font-size: var(--text-support); font-weight: var(--weight-medium); line-height: var(--leading-support); text-decoration: none; }
  .action-link svg { flex-shrink: 0; width: var(--icon-size); height: var(--icon-size); }
  .action-link--primary { padding: var(--space-1) var(--space-3); border-radius: var(--radius-action); background: var(--action-background, var(--color-pine)); color: var(--action-foreground, var(--color-white)); }
  .action-link--primary:focus-visible { outline-color: var(--action-focus, var(--color-pine)); }
  .action-link:hover span { text-decoration: underline; text-underline-offset: 0.2em; }
  .action-link--text { justify-content: start; color: inherit; }
</style>
