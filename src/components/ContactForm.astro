---
interface Props { tallyId: string; preview?: boolean }
const { tallyId, preview = true } = Astro.props;
const context = `source=ternloom-website&environment=${preview ? 'local-test' : 'production'}`;
const embedUrl = `https://tally.so/embed/${encodeURIComponent(tallyId)}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1&${context}`;
const directUrl = `https://tally.so/r/${encodeURIComponent(tallyId)}?${context}`;
---
<div class="contact-form">
  {preview && <p class="preview-note"><strong>Local preview — please use test details.</strong></p>}
  <p class="form-note">We use your details to respond. Read our <a href="/privacy/">privacy notice</a>.</p>
  <iframe src={embedUrl} title="Ternloom project enquiry"></iframe>
  {preview && <p class="preview-note submission-note">Submissions are sent to Tally and may trigger email notifications.</p>}
  <p class="direct-form"><a href={directUrl}>Open the enquiry form in Tally</a> if the embedded form does not load or is difficult to use.</p>
</div>
<script is:inline defer src="https://tally.so/widgets/embed.js"></script>
<style>
  .contact-form > p { max-width: var(--reading-width); }
  .contact-form > p + p { margin-block-start: var(--space-1); }
  .preview-note, .form-note { font-size: var(--text-support); line-height: var(--leading-support); }
  .form-note { color: var(--color-muted); }
  iframe { display: block; width: 100%; height: var(--contact-form-initial-height); border: 0; margin-block-start: var(--space-1); }
  .submission-note, .direct-form { margin-block-start: var(--space-2); }
</style>
