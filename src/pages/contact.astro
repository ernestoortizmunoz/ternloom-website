---
import SiteLayout from '../layouts/SiteLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContactDetails from '../components/ContactDetails.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../config/site';
import { services } from '../data/services';
const localTestForm = import.meta.env.TERNLOOM_RELEASE === '1' ? null : site.localTestForm;
---
<SiteLayout
  title="Discuss Your Project — Ternloom Technologies"
  description="Plan a website, custom software or business automation project. Tell Ternloom about your business, your current tools and what you want to change."
  pathname="/contact/"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact/' }]}
>
  <section class="container contact-intro" aria-labelledby="contact-title">
    <div class="intro-copy">
      <p class="eyebrow">A useful starting point</p>
      <h1 id="contact-title">Discuss your project</h1>
      <p class="contact-lead">What would make your work easier?</p>
      <p>Whether you need a clearer website, a tool built around your work or a better connection between systems, start with the problem you want to solve.</p>
      <p class="audience">For small businesses in Ottawa and across Canada.</p>
    </div>
    <ContactDetails contact={site.contact} confirmed={site.readiness.contactConfirmed} localTest={Boolean(localTestForm)} />
  </section>

  {localTestForm && (
    <section class="container contact-section" aria-labelledby="form-title">
      <SectionHeading id="form-title" eyebrow="Local preview">Try the project enquiry form</SectionHeading>
      <ContactForm tallyId={localTestForm.tallyId} />
    </section>
  )}

  <section class="container contact-section" aria-labelledby="include-title">
    <SectionHeading id="include-title" eyebrow="Before the conversation">What to include</SectionHeading>
    <p class="section-intro">You do not need a technical specification. A little context helps identify the right questions.</p>
    <ol class="prompt-list">
      <li><h3>Your business</h3><p>What does your business do, who are your customers, and who will use the website or software?</p></li>
      <li><h3>Your current tools</h3><p>Describe your website, spreadsheets, software or manual process, and where they make the work difficult.</p></li>
      <li><h3>What you want to change</h3><p>Explain the outcome you need. Include any timing, budget or existing-system constraints that will shape the project.</p></li>
    </ol>
  </section>

  <section class="container contact-section next-step" aria-labelledby="next-title">
    <SectionHeading id="next-title" eyebrow="Working together">What happens next</SectionHeading>
    <p>{!localTestForm && site.contact && site.readiness.contactConfirmed ? 'An initial conversation' : 'Once contact is available, an initial conversation'} can clarify the problem, the people involved and whether the work is a fit. Scope, deliverables and next steps are agreed before a project begins.</p>
  </section>

  <section class="container contact-section" aria-labelledby="services-title">
    <SectionHeading id="services-title" eyebrow="Explore the possibilities">Find the service that fits</SectionHeading>
    <div class="service-list">
      {services.map((service) => <article class="service-row"><h3><a href={service.path}>{service.name}</a></h3><p>{service.summary}</p></article>)}
    </div>
  </section>
</SiteLayout>
<style>
  .contact-intro { display: grid; grid-template-columns: 1.15fr 1fr; align-items: start; gap: var(--space-6); padding-block: var(--space-6) var(--section-space); }
  h1 { margin-block: var(--space-3); }
  .contact-lead { font-size: var(--text-section); line-height: var(--leading-heading); margin-block-end: var(--space-3); }
  .intro-copy > p:last-child { margin-block-start: var(--space-3); }
  .audience, .section-intro, .prompt-list p, .service-row p { color: var(--color-muted); }
  .contact-section { padding-block: var(--section-space); border-block-start: var(--border-width) solid var(--color-line); }
  .section-intro { max-width: var(--reading-width); margin-block-start: var(--space-3); }
  .prompt-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); padding-inline-start: var(--space-3); margin-block-start: var(--space-6); }
  .prompt-list li { padding-inline-start: var(--space-1); }
  .prompt-list li::marker { color: var(--color-rust); font-weight: var(--weight-medium); }
  .prompt-list h3 { margin-block-end: var(--space-2); }
  .next-step { display: grid; grid-template-columns: 1fr 1.25fr; gap: var(--space-4) var(--space-6); }
  .next-step > p { max-width: var(--reading-width); }
  .service-list { margin-block-start: var(--space-6); }
  .service-row { display: grid; grid-template-columns: 1fr 1.25fr; gap: var(--space-3) var(--space-6); padding-block: var(--space-4); border-block-start: var(--border-width) solid var(--color-line); }
  @media (max-width: 48rem) {
    .contact-intro, .prompt-list, .next-step, .service-row { grid-template-columns: 1fr; }
  }
</style>
