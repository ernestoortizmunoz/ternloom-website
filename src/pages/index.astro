---
import SiteLayout from '../layouts/SiteLayout.astro';
import { services } from '../data/services';
---
<SiteLayout title="Unfinished local setup — Ternloom Technologies" description="An unfinished local preview of the Ternloom Technologies website." pathname="/" noindex>
 <div class="container section flow">
  <h1>Ternloom Technologies — unfinished local setup</h1>
  <p>This page verifies the static website foundation. The website is not ready for publication.</p>
  <ul>
    {services.map((service) => <li data-service={service.id}>{service.name}</li>)}
  </ul>
  <p>Public contact details are awaiting confirmation.</p>
 </div>
</SiteLayout>
