    "test:publication": "node --test tests/publication.test.mjs",
    "build": "node scripts/build.mjs preview",
    "build:release": "node scripts/build.mjs release",
    "check:output": "node scripts/check-output.mjs"
  },
  "dependencies": {
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "turndown": "7.2.4",
    "typescript": "6.0.3",
    "wrangler": "4.156.0"
  }
}
